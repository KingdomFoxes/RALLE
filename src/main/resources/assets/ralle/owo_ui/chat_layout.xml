<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.19.4/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <spacer percent="100"/>
                <flow-layout direction="vertical" id="controls-panel">
                    <children>
                        <flow-layout direction="horizontal">
                            <children>
                                <flow-layout direction="vertical">
                                    <children>
                                        <checkbox id="free-move"><text translate="true">ralle.chat-layout.free-move</text></checkbox>
                                        <checkbox id="show-all"><text translate="true">ralle.chat-layout.show-all</text></checkbox>
                                    </children>
                                    <gap>4</gap>
                                    <sizing>
                                        <horizontal method="fixed">84</horizontal>
                                        <vertical method="content"/>
                                    </sizing>
                                </flow-layout>
                                <flow-layout direction="vertical">
                                    <children>
                                        <checkbox id="snap-grid"><text translate="true">ralle.chat-layout.snap-grid</text></checkbox>
                                        <checkbox id="show-grid"><text translate="true">ralle.chat-layout.show-grid</text></checkbox>
                                    </children>
                                    <gap>4</gap>
                                    <sizing>
                                        <horizontal method="fixed">94</horizontal>
                                        <vertical method="content"/>
                                    </sizing>
                                </flow-layout>
                                <flow-layout direction="vertical">
                                    <children>
                                        <checkbox id="alignment-guides"><text translate="true">ralle.chat-layout.alignment-guides</text></checkbox>
                                        <checkbox id="position-info"><text translate="true">ralle.chat-layout.position-info</text></checkbox>
                                    </children>
                                    <gap>4</gap>
                                    <sizing>
                                        <horizontal method="fixed">122</horizontal>
                                        <vertical method="content"/>
                                    </sizing>
                                </flow-layout>
                            </children>
                            <sizing>
                                <horizontal method="fixed">300</horizontal>
                                <vertical method="content"/>
                            </sizing>
                        </flow-layout>
                        <flow-layout direction="horizontal">
                            <children>
                                <button id="reset-button">
                                    <text translate="true">ralle.chat-layout.reset</text>
                                    <sizing><horizontal method="fixed">146</horizontal></sizing>
                                </button>
                                <button id="done-button">
                                    <text translate="true">gui.done</text>
                                    <sizing><horizontal method="fixed">146</horizontal></sizing>
                                </button>
                            </children>
                            <gap>8</gap>
                            <sizing>
                                <horizontal method="fixed">300</horizontal>
                                <vertical method="content"/>
                            </sizing>
                        </flow-layout>
                    </children>
                    <gap>4</gap>
                    <padding><all>8</all></padding>
                    <sizing>
                        <horizontal method="content"/>
                        <vertical method="content"/>
                    </sizing>
                </flow-layout>
            </children>
            <surface><vanilla-translucent/></surface>
            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>top</vertical-alignment>
            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
        </flow-layout>
    </components>
</owo-ui>
