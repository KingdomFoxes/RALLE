{
  "schemaVersion": 1,
  "id": "ralle",
  "version": "${version}",
  "name": "Raid Alliance Logistics Liaison Equipment",
  "description": "A client-side Wynncraft chat and Raid LFG mod for the Kingdom of Foxes alliance.",
  "authors": ["Kingdom of Foxes"],
  "contact": {
    "sources": "https://github.com/KingdomFoxes/RALLE",
    "issues": "https://github.com/KingdomFoxes/RALLE/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["org.kingdomfoxes.ralle.RalleClient"]
  },
  "mixins": [
    "ralle.mixins.json",
    "ralle.lfg.mixins.json",
    "ralle.consumables.mixins.json",
    "ralle.wynntils.mixins.json",
    "ralle.war.queue.mixins.json",
    "ralle.cosmetics.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "owo": ">=0.13.0"
  },
  "suggests": {
    "wynntils": ">=4.2.7"
  }
}
