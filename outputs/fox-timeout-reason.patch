+class RemovalReasonDeliveryTests(unittest.IsolatedAsyncioTestCase):
+    async def test_explicit_reason_reaches_visible_clients_without_leaking_to_others(self):
+        hub = LiveHub()
+        lobby = {"lobby_id": str(uuid4())}
+        visible = LiveConnection(None, {}, 0, removal_reasons=True)
+        visible.visible_lobby_ids.add(lobby["lobby_id"])
+        hidden = LiveConnection(None, {}, 0)
+        await hub.register(visible)
+        await hub.register(hidden)
+        await hub.broadcast_remove(lobby, 4, 1, lambda player, party: False,
+                                   reason="lobby_expired")
+        frame = visible.queue.get_nowait()
+        self.assertEqual(frame["reason"], "lobby_expired")
+        LiveRemoveFrame.model_validate(frame)
+        self.assertFalse(visible.visible_lobby_ids)
+        self.assertTrue(hidden.queue.empty())
+
+    async def test_ordinary_removal_retains_legacy_shape(self):
+        hub = LiveHub()
