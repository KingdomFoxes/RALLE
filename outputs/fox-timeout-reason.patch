+    async def expire_unfilled_lobbies(self, now: datetime) -> list[tuple[dict, int]]:
+        """Atomically expire initial recruitment; activity never extends its deadline."""
+        cutoff = (now.astimezone(timezone.utc) - timedelta(
+            seconds=RECRUITMENT_TIMEOUT_SECONDS)).isoformat()
+
+        def work(con):
+            self._begin(con)
+            try:
+                ids = [row[0] for row in con.execute(
+                    "SELECT lobby_id FROM ralle_lfg_lobbies WHERE recruitment_completed=0 "
+                    "AND created_at<=? AND status='OPEN' AND "
+                    "(SELECT count(*) FROM ralle_lfg_members m "
+                    "WHERE m.lobby_id=ralle_lfg_lobbies.lobby_id)<4 "
+                    "ORDER BY created_at,lobby_id", (cutoff,))]
+                expired = []
+                for lobby_id in ids:
+                    lobby = self._lobby(con, lobby_id)
+                    changed = now_iso()
+                    revision = self._revision(con)
+                    payload = self._event_payload(
+                        con, lobby, cause="lobby.expire", reason="lobby_expired")
+                    con.execute("DELETE FROM ralle_lfg_lobbies WHERE lobby_id=?", (lobby_id,))
+                    self._outbox(con, lobby_id, "lobby.remove", revision, payload, changed)
+                    expired.append((lobby, revision))
+                con.commit()
+                return expired
+            except Exception:
+                con.rollback()
+                raise
+        return await self._run(work)
+
